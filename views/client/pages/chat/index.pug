extends ../../layouts/default.pug
block main
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    .container.my-4
        .d-flex.justify-content-center.mb-4
            .chat-nav-menu.d-flex.flex-wrap.gap-3
                a.chat-nav-btn(href="/users/notFriend")
                    i.bi.bi-people-fill
                    span Danh sách người dùng
                a.chat-nav-btn(href="/users/accept")
                    i.bi.bi-envelope-paper-heart-fill
                    span Lời mời kết bạn
                a.chat-nav-btn(href="/users/request")
                    i.bi.bi-send-check-fill
                    span Lời mời đã gửi
                a.chat-nav-btn(href="/users/friends")
                    i.bi.bi-person-heart
                    span Danh sách bạn bè

        .chat-container(data-user-id=currentUser.id)
            // Sidebar
            .chat-sidebar
                .chat-header-sidebar
                    h4.chat-title Chat
                    .chat-search
                        input(type="text" placeholder="Tìm kiếm tin nhắn...")
                
                .chat-list
                    .chat-list-item.active
                        img.chat-avatar(src="https://ui-avatars.com/api/?name=Nhóm+Chung&background=0D8ABC&color=fff", alt="")
                        .chat-info
                            .chat-name-time
                                span.chat-name Phòng Chat Chung
                                span.chat-time 10:30
                            span.chat-preview Chào mọi người ngày mới vui vẻ!
                    
                    .chat-list-item
                        img.chat-avatar(src="https://ui-avatars.com/api/?name=Hỗ+Trợ&background=F39C12&color=fff", alt="")
                        .chat-info
                            .chat-name-time
                                span.chat-name Hỗ trợ khách hàng
                                span.chat-time Hôm qua
                            span.chat-preview Chào bạn, mình cần hỗ trợ về đơn hàng.

            // Main Chat Area
            .chat-main
                .chat-header-main
                    .chat-header-user
                        img.chat-avatar(src="https://ui-avatars.com/api/?name=Nhóm+Chung&background=0D8ABC&color=fff", alt="")
                        .chat-header-info
                            h5.chat-header-name Phòng Chat Chung
                            span.chat-header-status Đang hoạt động
                    .chat-header-actions
                        button.chat-btn-action: i.bi.bi-telephone
                        button.chat-btn-action: i.bi.bi-camera-video
                        button.chat-btn-action: i.bi.bi-info-circle
                
                .chat-messages
                    if chats && chats.length > 0
                        each chat in chats
                            if chat.user_id == currentUser.id
                                .message.message-outgoing
                                    - var myName = currentUser.fullName ? currentUser.fullName : "Me"
                                    img.chat-avatar.message-avatar(src=`https://ui-avatars.com/api/?name=${myName}&background=random&color=fff`, alt=myName title=myName)
                                    .message-content
                                        .inner-name= myName
                                        if chat.content
                                            if chat.type === 'sticker'
                                                .message-bubble.sticker-bubble= chat.content
                                            else
                                                .message-bubble= chat.content
                                        if chat.images && chat.images.length > 0
                                            .message-images
                                                each img in chat.images
                                                    img.message-img(src=img, alt="")
                            else
                                .message.message-incoming
                                    - var name = chat.infoUser ? chat.infoUser.fullName : "U"
                                    img.chat-avatar.message-avatar(src=`https://ui-avatars.com/api/?name=${name}&background=random&color=fff`, alt=name title=name)
                                    .message-content
                                        .inner-name= name
                                        if chat.content
                                            if chat.type === 'sticker'
                                                .message-bubble.sticker-bubble= chat.content
                                            else
                                                .message-bubble= chat.content
                                        if chat.images && chat.images.length > 0
                                            .message-images
                                                each img in chat.images
                                                    img.message-img(src=img, alt="")
                            
                            
                .typing-indicator#typingIndicator
                    .typing-avatar
                    .typing-text
                        span.typing-name
                        .typing-dots
                            span.typing-dot
                            span.typing-dot
                            span.typing-dot
                .chat-preview-images#chatPreviewImages
                .chat-input-area
                    button.chat-btn-attach#btnAttach: i.bi.bi-paperclip
                    input(type="file" id="chat-file-input" multiple accept="image/*" class="d-none")
                    textarea.chat-input(placeholder="Nhập tin nhắn..." rows="1")
                    .sticker-wrapper
                        button.chat-btn-sticker#btnSticker: i.bi.bi-emoji-smile
                        .sticker-picker#stickerPicker
                            .sticker-picker-header
                                .sticker-tabs
                                    button.sticker-tab.active(data-category="smileys") 😀
                                    button.sticker-tab(data-category="gestures") 👋
                                    button.sticker-tab(data-category="animals") 🐶
                                    button.sticker-tab(data-category="food") 🍕
                                    button.sticker-tab(data-category="activities") ⚽
                                    button.sticker-tab(data-category="travel") 🚗
                                    button.sticker-tab(data-category="objects") 💡
                                    button.sticker-tab(data-category="hearts") ❤️
                            .sticker-grid#stickerGrid
                    button.chat-btn-send: i.bi.bi-send-fill
    
    // Lightbox for image zoom
    #chat-image-lightbox.chat-lightbox
        span.lightbox-close &times;
        img.lightbox-content#lightbox-img

    link(rel="stylesheet", href="/client/css/chat.css")

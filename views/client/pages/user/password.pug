extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-error(4000)
    +alert-success(3000)

    main.account-profile
        .account-profile__shell
            section.account-profile__hero
                .account-profile__avatar
                    if currentUser.avatar
                        img(src=currentUser.avatar alt=currentUser.fullName)
                    else
                        | #{(currentUser.fullName || currentUser.email || "U").charAt(0).toUpperCase()}
                .account-profile__heading
                    p.account-profile__eyebrow Bảo mật
                    h1.account-profile__title Thay đổi mật khẩu
                    p.account-profile__email= currentUser.email

            section.account-profile__card
                h2.account-profile__section-title Cập nhật mật khẩu
                form.account-profile__form(action="/user/profile/password" method="POST")
                    .client-auth__group
                        label.client-auth__label(for="currentPassword") Mật khẩu hiện tại
                        input#currentPassword.client-auth__input(
                            type="password"
                            name="currentPassword"
                            autocomplete="current-password"
                            required
                        )

                    .client-auth__group
                        label.client-auth__label(for="newPassword") Mật khẩu mới
                        input#newPassword.client-auth__input(
                            type="password"
                            name="newPassword"
                            autocomplete="new-password"
                            required
                        )

                    .client-auth__group
                        label.client-auth__label(for="confirmPassword") Xác nhận mật khẩu mới
                        input#confirmPassword.client-auth__input(
                            type="password"
                            name="confirmPassword"
                            autocomplete="new-password"
                            required
                        )

                    .account-profile__actions
                        button.account-profile__button(type="submit") Lưu mật khẩu
                        a.account-profile__button.account-profile__button--ghost(href="/user/profile") Hủy

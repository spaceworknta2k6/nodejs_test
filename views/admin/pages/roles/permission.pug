extends ../../layouts/default.pug
include ../../mixins/admin/alert.pug

block main
  +alert-success(3000)
  +alert-error(3000)
  .permission-page
    .permission-card
      .permission-card__head
        h1.permission-title Phân quyền
        if(role.permission.includes("roles_create"))
          a.btn.btn-outline-success(href=`${PrefixAdmin}/roles/create`) + Thêm nhóm quyền
      if(record)
        div(data-records=record style="display: none;")

      .permission-table-wrap
        table.permission-table(table-permissions)
          thead
            tr
              th Tính năng 
              each item in record 
                th.text-center #{item.title}
          tbody 
            tr(data-name="id" style="display: none;")
              td 
              each role in record
                td.permission-check
                  input(type="text" value=role._id)
            
            //- Danh mục sản phẩm
            tr.permission-group
              td(colspan="100")
                b Danh mục sản phẩm
            tr(data-name="products_view")
              td.permission-name Xem
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="products_create")
              td.permission-name Thêm mới
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="products_edit")
              td.permission-name Chỉnh sửa
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="products_delete")
              td.permission-name Xóa
              each role in record
                td.permission-check
                  input(type="checkbox")

            //- Nhóm quyền
            tr.permission-group
              td(colspan="100")
                b Nhóm quyền
            tr(data-name="roles_view")
              td.permission-name Xem
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="roles_create")
              td.permission-name Thêm mới
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="roles_edit")
              td.permission-name Chỉnh sửa
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="roles_delete")
              td.permission-name Xóa
              each role in record
                td.permission-check
                  input(type="checkbox")
            
            //- Phan quyen
            tr.permission-group
              td(colspan="100")
                b Phân quyền
            tr(data-name="permissions_view")
              td.permission-name Xem
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="permissions_create")
              td.permission-name Thêm mới
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="permissions_edit")
              td.permission-name Chỉnh sửa
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="permissions_delete")
              td.permission-name Xóa
              each role in record
                td.permission-check
                  input(type="checkbox")
            
            //- Tài khoản
            tr.permission-group
              td(colspan="100")
                b Tài khoản
            tr(data-name="accounts_view")
              td.permission-name Xem
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="accounts_create")
              td.permission-name Thêm mới
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="accounts_edit")
              td.permission-name Chỉnh sửa
              each role in record
                td.permission-check
                  input(type="checkbox")
            tr(data-name="accounts_delete")
              td.permission-name Xóa
              each role in record
                td.permission-check
                  input(type="checkbox")
      
      div(style="text-align: right; padding: 16px;")
        button.permission-submit(
          type="submit"
          button-submit
        ) Cập nhật

  //- Form ẩn dùng để gửi dữ liệu lên server
  form#form-change-permissions(method="POST" action=`${PrefixAdmin}/roles/permission?_method=PATCH` style="display: none;")
    .form-group
      input(type="text" class="form-control" name="permissions")

  script(src=`${PrefixAdmin}/js/role.js`)

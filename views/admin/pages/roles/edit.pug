extends ../../layouts/default.pug
include ../../mixins/admin/alert.pug

block main
  - const currentRole = record
  - const formAction = currentRole ? `${PrefixAdmin}/roles/edit/${currentRole._id}?_method=PATCH` : "#"

  +alert-success(3000)
  +alert-error(3000)

  if !currentRole
    .empty-state
      .empty-state__icon PQ
      h3.mb-2 Không tìm thấy nhóm quyền
      p.mb-0 Nhóm quyền này không tồn tại hoặc đã bị xóa.
      a.create-btn.create-btn--primary.mt-3(href=`${PrefixAdmin}/roles`) Quay lại
  else
    section.product-create-page.roles-page
      .create-hero
        .create-hero__content
          span.create-hero__kicker Quản lý nhóm quyền
          h1.create-hero__title Chỉnh sửa nhóm quyền
          p.section-heading__desc Cập nhật tên và mô tả của nhóm quyền trong hệ thống.

      .create-shell
        .create-panel
          form.create-product-form(
            action=formAction
            method="POST"
          )
            .create-section
              .section-heading
                span.section-heading__eyebrow Thông tin nhóm quyền
                h2.section-heading__title Nội dung cơ bản
                p.section-heading__desc Kiểm tra lại thông tin trước khi lưu thay đổi.

              .create-grid
                .field-group.field-group--full
                  label.field-label(for="title")
                    | Tiêu đề
                    span.required-badge Bắt buộc
                  input#title.form-control-modern(
                    type="text"
                    name="title"
                    required
                    placeholder="Ví dụ: Quản lý sản phẩm"
                    value=currentRole.title || ""
                  )

                .field-group.field-group--full
                  label.field-label(for="description") Mô tả
                  textarea#description.form-control-modern.form-control-modern--textarea(
                    name="description"
                    rows="6"
                    placeholder="Mô tả nhóm quyền"
                  )= currentRole.description || ""

            .form-footer
              p.form-footer__note Lưu thay đổi để cập nhật thông tin nhóm quyền.
              .form-footer__actions
                a.create-btn.create-btn--ghost(href=`${PrefixAdmin}/roles`) Quay lại
                button.create-btn.create-btn--primary(type="submit") Cập nhật

header.admin-header
    button.admin-menu-toggle(type="button" data-admin-sidebar-toggle aria-label="Mở menu")
        span
        span
        span
    -
        const currentUser = user || {};
        const displayName = currentUser.fullName || currentUser.email || "Admin";
        const initials = displayName
            .trim()
            .split(/\s+/)
            .slice(0, 2)
            .map((word) => word.charAt(0))
            .join("")
            .toUpperCase();
    .header-copy
        h2.mb-1 #{PageTitle}
        p.mb-0 Cập nhật mới nhất: hôm nay
    .header-actions
        input.form-control.form-control-sm(type="search" placeholder="Tìm kiếm nhanh...")
        a.header-user(href=`${PrefixAdmin}/my-account` title="Thông tin cá nhân")
            if currentUser.avatar
                img.avatar.avatar--image(src=currentUser.avatar alt=displayName)
            else
                .avatar= initials || "AD"
            span.header-user__name= displayName
        a.btn-logout.text-decoration-none(href=`${PrefixAdmin}/auth/logout` title="Đăng xuất")
            i.bi.bi-box-arrow-right
            span Đăng xuất

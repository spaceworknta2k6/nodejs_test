aside.admin-sidebar
    button.admin-sidebar__close(type="button" data-admin-sidebar-close aria-label="Đóng menu") ×
    .sidebar-brand
        .brand-logo NTA
        .brand-copy
            strong NTA Admin
            span Quản trị hệ thống

    nav.sidebar-nav
        a.nav-item.active(href=`${PrefixAdmin}/dashboard`)
            span Tổng quan
        if(role.permission.includes("products_view"))
            a.nav-item(href=`${PrefixAdmin}/product`)
                span Sản phẩm
        a.nav-item(href="#")
            span Đơn hàng
        a.nav-item(href="#")
            span Khách hàng
        if(role.permission.includes("roles_view"))
            a.nav-item(href=`${PrefixAdmin}/roles`)
                span Nhóm quyền
        if(role.permission.includes("accounts_view"))
            a.nav-item(href=`${PrefixAdmin}/accounts`)
                span Tài khoản
        if(role.permission.includes("permissions_view"))
            a.nav-item(href=`${PrefixAdmin}/roles/permission`)
                span Phân Quyền
    .sidebar-help
        p.mb-2 Cần hỗ trợ nhanh?
        button.btn.btn-light.btn-sm.w-100 Liên hệ kỹ thuật
